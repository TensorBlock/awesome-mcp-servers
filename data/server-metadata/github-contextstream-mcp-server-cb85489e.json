  },
  "install": {
    "commands": [
      "npx --prefer-online -y @contextstream/mcp-server@latest setup"
    ],
    "env": [
      "CONTEXTSTREAM_API_URL",
      "CONTEXTSTREAM_API_KEY"
    ],
    "confidence": "medium"
  },
  "transport": [
    "stdio",
    "streamable-http"
  ],
  "auth": {
    "type": "api-key",
    "notes": [
      "Hosted Streamable HTTP requests use the X-ContextStream-API-Key header from the ContextStream dashboard.",
      "Local setup stores CONTEXTSTREAM_API_KEY for the stdio package."
    ]
  },
  "clients": [
    "Cursor",
    "Claude Code",
    "Codex",
    "Grok",
    "Windsurf",
