{
  "$schema": "../../schemas/server-metadata.schema.json",
  "id": "github-edouard-claude-whatsapp-mcp-f02134b3",
  "source": {
    "issue": 4167,
    "projectUrl": "https://github.com/edouard-claude/whatsapp-mcp"
  },
  "install": {
    "commands": [
      "wa-mcp serve"
    ],
    "env": [
      "WA_DATA_DIR",
      "WA_READ_ONLY",
      "RUST_LOG"
    ],
    "confidence": "medium"
  },
  "transport": [
    "stdio"
  ],
  "auth": {
    "type": "none",
