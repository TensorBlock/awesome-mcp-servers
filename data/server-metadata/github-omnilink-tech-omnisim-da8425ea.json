  "description": "Stdio MCP adapter for OmniSim's local World Harness. Agents can load or hot-sync robot worlds, inspect scenes and robot state, frame cameras, capture screenshots, step or reset simulation, and read events while the simulator stays local.",
  "category": "Developer Productivity & Utilities",
  "links": {
    "docs": "https://github.com/omnilink-tech/omnisim/tree/main/packages/omnisim-mcp"
  },
  "install": {
    "commands": [
      "git clone https://github.com/omnilink-tech/omnisim && cd omnisim && pip install -e packages/omnisim-mcp",
      "python scripts/dev/omnisim_dev.py harness",
      "OMNISIM_HARNESS_URL=http://127.0.0.1:6789 omnisim-mcp"
    ],
    "env": [
      "OMNISIM_HARNESS_URL"
    ],
    "confidence": "high"
  },
  "transport": [
    "stdio"
  ],
  "auth": {
    "type": "none",
    "notes": []
  },
  "clients": [
